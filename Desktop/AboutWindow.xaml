<Window xmlns:loc="clr-namespace:UnattendLocal.Desktop" x:Class="UnattendLocal.Desktop.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{loc:Text text.4b9659ed544c}" Icon="Assets/App.ico" Width="820" Height="640" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Window.Resources>
    <Style x:Key="AboutDocument" TargetType="RichTextBox">
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="IsDocumentEnabled" Value="True"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" Padding="20,18"><StackPanel>
      <TextBlock Text="{loc:Text text.4b9659ed544c}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="{loc:Text text.b55baaa9f16b}" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <TabControl x:Name="Sections" Grid.Row="1" TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0">
      <TabItem Header="{loc:Source text.52d25a9e30ba}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
          <Border Style="{StaticResource Card}"><StackPanel>
            <Image x:Name="ProductIcon" Width="56" Height="56" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <TextBlock Text="UnattendLocal" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource AccentTextBrush}" FontSize="18" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="MIT License · Copyright © 2026 tigerJX95" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="{loc:Text text.bf91a0c0460e}" TextAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="Windows x64 · .NET 10" TextAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
          </StackPanel></Border>
          <TextBlock Style="{StaticResource ExplanationText}" Text="{loc:Text text.bf9d3bf450fd}"/>
          <TextBlock Text="{loc:Text text.ef4b1999984a}" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <TextBlock Style="{StaticResource ExplanationText}" Text="{loc:Text text.02b056aa5848}"/>
          <TextBlock x:Name="ProjectLink" Style="{StaticResource ExplanationText}" AutomationProperties.Name="{loc:Text text.59463068ece0}">
            <Run Text="{loc:Text about.projectLinkLabel}"/><Run Text=" "/><Hyperlink NavigateUri="https://github.com/tigerJX95/UnattendLocal" RequestNavigate="RepositoryLinkNavigate" Foreground="{DynamicResource AccentTextBrush}" TextDecorations="Underline" Cursor="Hand"><Run Text="https://github.com/tigerJX95/UnattendLocal"/></Hyperlink>
          </TextBlock>
          <TextBlock Text="{loc:Text text.d5aacdb5bf2c}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Source text.027d17dd49ef}">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Text text.27b806078d8a}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <RichTextBox x:Name="LegalText" Grid.Row="1" Style="{StaticResource AboutDocument}" AutomationProperties.Name="{loc:Text text.cb56e4fc8e0c}"/>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:Source text.038ad816c53f}">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Text text.24e1b1a67d45}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <ComboBox x:Name="LicensePicker" Grid.Row="1"  SelectionChanged="LicenseChanged" AutomationProperties.Name="{loc:Text text.fdd2efe9d38b}" loc:LocalizedItems.DisplayPath="Title"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Display Value={Binding Title}}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <RichTextBox x:Name="LicenseText" Grid.Row="2" Style="{StaticResource AboutDocument}" AutomationProperties.Name="{loc:Text text.5e04a0e44066}"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
