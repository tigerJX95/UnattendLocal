<Window x:Class="UnattendLocal.Desktop.SetupLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UnattendLocal.Desktop"
        Title="{loc:Text setupLogs.title}" Width="880" Height="560" MinWidth="460" MinHeight="330"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Close" Executed="CloseExecuted"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
  </Window.InputBindings>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <Button x:Name="OpenButton" DockPanel.Dock="Left" Content="{loc:Source setupLogs.choose}" Click="OpenClick" Margin="0,0,12,4">
        <Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Text setupLogs.hint}" /></Button.ToolTip>
      </Button>
      <TextBlock x:Name="LogName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,6,0,8">
      <Label x:Name="LogFilterLabel" DockPanel.Dock="Left" Content="{loc:Text setupLogs.filter}"
             Foreground="{DynamicResource ForegroundBrush}" Target="{Binding ElementName=LogFilter}" Padding="0,7,10,7" />
      <TextBox x:Name="LogFilter" IsEnabled="False" MaxLength="256" TextChanged="FilterChanged" />
    </DockPanel>
    <TextBlock Grid.Row="2" x:Name="TruncatedNotice" Text="{loc:Text setupLogs.truncated}" Visibility="Collapsed"
               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox Grid.Row="3" x:Name="LogText" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="NoWrap"
             FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="{loc:Text setupLogs.contents}" />
    <TextBlock Grid.Row="4" x:Name="LogStatus" Text="{loc:Text setupLogs.hint}" Foreground="{DynamicResource SecondaryBrush}"
               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,0,0" />
  </Grid>
</Window>
