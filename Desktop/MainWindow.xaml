              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor077" Text="账户锁定策略" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[accountlockout],RelativeSource={RelativeSource AncestorType=Window}}"/>
