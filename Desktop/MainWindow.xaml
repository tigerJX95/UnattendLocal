                  <TextBlock Text="Wi-Fi 密码" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <PasswordBox IsEnabled="{Binding IsPasswordWifi}" x:Name="WifiPassword" PasswordChanged="WifiPasswordChanged" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <CheckBox x:Name="SettingAnchor085" Content="隐藏网络" IsChecked="{Binding Plan.HiddenWifi}" ToolTip="{Binding DataContext.HelpTips[hidden],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <CheckBox x:Name="SettingAnchor086" Content="自动连接预设 Wi-Fi" IsChecked="{Binding Plan.ConnectWifi}" ToolTip="{Binding DataContext.HelpTips[hidden],RelativeSource={RelativeSource AncestorType=Window}}" />
