                  <TextBlock Text="内置 Administrator 密码" Foreground="{DynamicResource SecondaryBrush}"/>
                  <PasswordBox x:Name="BuiltinAdministratorPassword" PasswordChanged="BuiltinPasswordChanged" Loaded="BuiltinPasswordLoaded" ToolTip="{Binding DataContext.HelpTips[builtinlogon],RelativeSource={RelativeSource AncestorType=Window}}"/>
