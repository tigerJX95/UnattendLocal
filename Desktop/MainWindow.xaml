<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UnattendLocal.Desktop" xmlns:core="clr-namespace:UnattendLocal.Core;assembly=Core" x:Class="UnattendLocal.Desktop.MainWindow" Icon="Assets/App.ico" Title="Windows 无人值守配置工具 · V0.1 pre45" Width="1060" Height="780" MinWidth="850" MinHeight="620" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="14">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="24,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="新建推荐配置" Click="NewClick" />
          <Button Content="新建自定义配置" Click="NewCustomClick" />
          <Button Content="打开方案" Click="OpenClick" />
          <Button Content="导入应答 XML" Click="ImportAnswerClick" />
          <Button Content="保存方案" Click="SaveClick" />
          <Button x:Name="ThemeToggleButton" Click="ThemeToggleClick" ContentTemplate="{x:Null}">
            <Button.ToolTip><ToolTip x:Name="ThemeToggleTip" ContentTemplate="{x:Null}" Content="切换为深色主题"/></Button.ToolTip>
            <Grid Width="20" Height="20">
              <Path x:Name="ThemeMoon" Data="M17,13 A8,8 0 1 1 9,2 A6,6 0 0 0 17,13 Z" Stretch="Uniform" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
              <Path x:Name="ThemeSun" Data="M10,5 A5,5 0 1 1 9.99,5 Z M10,1 V3 M10,17 V19 M1,10 H3 M17,10 H19 M3.6,3.6 L5,5 M15,15 L16.4,16.4 M3.6,16.4 L5,15 M15,5 L16.4,3.6" Stretch="Uniform" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Grid>
          </Button>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Windows 无人值守配置" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="安装 · 账户 · 网络 · 外观" Foreground="{DynamicResource SecondaryBrush}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Padding="24,10">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>
    <TabControl x:Name="Pages" TabStripPlacement="Left" Background="{DynamicResource CanvasBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabItem Header="配置方案" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
          <Border Style="{StaticResource Card}" Visibility="{Binding HasImportedXml,Converter={StaticResource VisibleWhen}}"><StackPanel>
            <TextBlock Text="已导入的 XML" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding XmlImportSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　已还原的设置可在分类页修改；未完全识别或尚未实现的内容保留在原 XML 中。检查与导出会尝试合并修改，冲突时停止，不自动丢弃原配置。" Foreground="{DynamicResource SecondaryBrush}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding XmlImportDetails}" Foreground="{DynamicResource WarningBrush}"/>
            <StackPanel Visibility="{Binding HasImportedXmlRisk,Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　原 XML 含磁盘配置或 Windows PE 命令，可能清空、格式化磁盘或执行其他命令。界面中的磁盘摘要不能代表全部原文操作范围，请重新核对原文件。" Foreground="{DynamicResource WarningBrush}"/>
              <CheckBox Content="已核对导入 XML 中全部磁盘及 Windows PE 操作、完成备份并获得授权" IsChecked="{Binding Plan.ConfirmImportedXmlRisk}" ToolTip="此确认不会执行命令；导出时仍有危险操作确认。新建方案或修改磁盘配置后需要重新确认。"/>
            </StackPanel>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　新建配置会重新开始；应用推荐值只调整推荐涉及的设置，原文仍保留，相关内容冲突时将阻止导出。导入不会运行任何安装命令。" Foreground="{DynamicResource SecondaryBrush}"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="推荐配置与自定义配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　推荐配置提供可修改的起点。自定义配置可从基础值开始，由你逐项选择或填写。所有模式均使用左侧各分类页面。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
            <TextBlock Text="配置方式" Margin="0,12,0,0" />
            <ComboBox SelectionChanged="ConfigurationModeChanged" SelectedValue="{Binding Plan.ConfigurationMode}" SelectedValuePath="Content"><ComboBoxItem Content="推荐配置"><ComboBoxItem.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="先应用建议值，再逐项调整。所有设置均可修改。" TextWrapping="Wrap" /></ToolTip></ComboBoxItem.ToolTip></ComboBoxItem><ComboBoxItem Content="自定义配置"><ComboBoxItem.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="切换时可选择从基础值重新开始，或明确保留当前设置；推荐场景将隐藏。" TextWrapping="Wrap" /></ToolTip></ComboBoxItem.ToolTip></ComboBoxItem></ComboBox>
            <StackPanel Visibility="{Binding IsRecommended,Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="推荐场景" />
              <ComboBox SelectedValue="{Binding PendingRecommendation}" SelectedValuePath="Tag"><ComboBoxItem Content="有线局域网" Tag="wired"><ComboBoxItem.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="使用 Windows 默认 DHCP，并跳过 Wi-Fi 配置。静态 IP 仍需安装后设置。" TextWrapping="Wrap" /></ToolTip></ComboBoxItem.ToolTip></ComboBoxItem><ComboBoxItem Content="预设 Wi-Fi" Tag="wifi"><ComboBoxItem.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="选择后网络页立即切换为预设 Wi-Fi 并启用自动连接；请填写 SSID 和 WPA2 密码，并核对无线驱动。" TextWrapping="Wrap" /></ToolTip></ComboBoxItem.ToolTip></ComboBoxItem></ComboBox>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　有线使用默认 DHCP；无线方案需要填写 SSID 和密码。切换场景立即同步网络页，其余策略可通过下方按钮应用或恢复。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　共同推荐关闭 OOBE 快捷隐私、预设本地账户、首次自动登录一次、隐藏脚本窗口、阻止设备自动加密并清理安装凭据。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　Windows 11 默认允许离线安装；硬件检查绕过默认关闭。" Foreground="{DynamicResource SecondaryBrush}"/>
              <Button Content="应用 / 恢复整套推荐值" Click="ApplyRecommendationClick" HorizontalAlignment="Left" />
            </StackPanel>
            <Button Content="从基础值重新开始自定义配置" Click="NewCustomClick" HorizontalAlignment="Left" Visibility="{Binding IsCustomConfiguration,Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding RecommendationState}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource ExplanationText}" Visibility="{Binding IsRecommended,Converter={StaticResource VisibleWhen}}" Text="　　应用推荐值会覆盖推荐涉及的开关和策略；保留账户、凭据、计算机名、语言区域、架构和所选 SKU。磁盘恢复为手动模式并取消危险操作确认；这些保留项仍须逐项核对。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding IsRecommended,Converter={StaticResource VisibleWhen}}"><StackPanel>
            <TextBlock Text="已调整的推荐设置" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding DifferenceHint,StringFormat='　　{0}'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding RecommendationDifferences}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><DockPanel>
                <Button DockPanel.Dock="Right" Content="恢复此项" Tag="{Binding Property}" Click="RestoreRecommendationClick" IsEnabled="{Binding DataContext.IsRecommended,RelativeSource={RelativeSource AncestorType=Window}}" />
                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Current,StringFormat=当前：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Recommended,StringFormat=推荐：{0}}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
              </DockPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前配置摘要" FontSize="18" FontWeight="SemiBold"/><local:ConfigurationSummaryView Summary="{Binding ConfigurationSummary}" IsDestructiveDisk="{Binding IsDestructiveDisk}" Margin="0,16,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="基础设置" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="基础设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="计算机名（留空自动生成）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[computer],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox Text="{Binding Plan.ComputerName,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.HelpTips[computer],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="目标架构" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[architecture],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox SelectedValue="{Binding Plan.Architecture}" SelectedValuePath="Tag" ToolTip="{Binding DataContext.HelpTips[architecture],RelativeSource={RelativeSource AncestorType=Window}}">
                  <ComboBoxItem Content="x64（Intel / AMD 64 位）" Tag="amd64">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="amd64" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="适用于常见的 Intel / AMD 64 位电脑，请使用相同架构的安装镜像。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="ARM64（ARM 64 位）" Tag="arm64">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="arm64" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="适用于 ARM 64 位电脑，请使用 ARM64 安装镜像。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="x86（32 位）" Tag="x86">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="x86" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="适用于 32 位安装镜像。桌面工具本身的运行架构不随此项改变。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <CheckBox Content="安装时手动选择语言与区域" IsChecked="{Binding Plan.InteractiveLanguage}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　自定义基础配置不预填语言与区域；请在此提前选择，生成前会检查必填项。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Visibility="{Binding IsCustomConfiguration,Converter={StaticResource VisibleWhen}}" />
                <StackPanel IsEnabled="{Binding IsFixedLanguage}">
                <TextBlock Text="显示语言（必须与安装镜像匹配）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.ImageLanguage}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="区域格式" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox ItemsSource="{Binding Locales}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.Locale}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="键盘 / 输入法" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox ItemsSource="{Binding Keyboards}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.Keyboard}" ToolTip="{Binding DataContext.HelpTips[language],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="国家或地区" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[region],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox ItemsSource="{Binding Regions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.GeoId}" ToolTip="{Binding DataContext.HelpTips[region],RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="时区设置方式" />
                <ComboBox SelectedValue="{Binding Plan.TimeZoneMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[timezone],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="由 Windows 决定"/><ComboBoxItem Content="指定时区"/></ComboBox>
                <TextBlock Text="时区" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[region],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox IsEnabled="{Binding IsFixedTimeZone}" ItemsSource="{Binding TimeZones}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.TimeZone}" ToolTip="{Binding DataContext.HelpTips[region],RelativeSource={RelativeSource AncestorType=Window}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="锁定键初始状态与按键行为" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[lockkeys],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <ComboBox SelectedValue="{Binding Plan.LockKeyMode}" SelectedValuePath="Tag" ToolTip="{Binding DataContext.HelpTips[lockkeys],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="使用 Windows 默认状态" Tag="使用 Windows 默认状态"/><ComboBoxItem Content="自定义初始状态与按键行为" Tag="自定义初始状态"/></ComboBox>
              <StackPanel IsEnabled="{Binding IsCustomLockKeys}" Visibility="{Binding IsCustomLockKeys,Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Num Lock（数字锁定）" Margin="0,12,0,4" FontWeight="SemiBold"/>
                <CheckBox Content="初始开启" IsChecked="{Binding Plan.InitialNumLockOn}" ToolTip="{Binding DataContext.HelpTips[numlock],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="忽略此键的按键（无法用此键切换）" IsChecked="{Binding Plan.IgnoreNumLock}" ToolTip="{Binding DataContext.HelpTips[lockbehavior],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="Caps Lock（大写锁定）" Margin="0,12,0,4" FontWeight="SemiBold"/>
                <CheckBox Content="初始开启" IsChecked="{Binding Plan.InitialCapsLockOn}" ToolTip="{Binding DataContext.HelpTips[capslock],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="忽略此键的按键（无法用此键切换）" IsChecked="{Binding Plan.IgnoreCapsLock}" ToolTip="{Binding DataContext.HelpTips[lockbehavior],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="Scroll Lock（滚动锁定）" Margin="0,12,0,4" FontWeight="SemiBold"/>
                <CheckBox Content="初始开启" IsChecked="{Binding Plan.InitialScrollLockOn}" ToolTip="{Binding DataContext.HelpTips[scrolllock],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="忽略此键的按键（无法用此键切换）" IsChecked="{Binding Plan.IgnoreScrollLock}" ToolTip="{Binding DataContext.HelpTips[lockbehavior],RelativeSource={RelativeSource AncestorType=Window}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding LockKeyStateSummary,StringFormat='　　{0}'}" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　自定义模式下，未勾选初始开启表示初始关闭。忽略按键会影响目标系统所有用户和登录界面，请先确认所需状态；可能覆盖其他键盘重映射设置。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　固件、驱动及 Windows 行为可能影响实际效果。切回默认仅改变新生成的配置，不自动清除已安装系统的按键映射。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="粘滞键" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[stickykeys],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <ComboBox SelectedValue="{Binding Plan.StickyKeysMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[stickykeys],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="使用 Windows 默认设置"/><ComboBoxItem Content="禁用粘滞键"/><ComboBoxItem Content="自定义粘滞键"/></ComboBox>
              <StackPanel IsEnabled="{Binding IsCustomStickyKeys}" Visibility="{Binding IsCustomStickyKeys,Converter={StaticResource VisibleWhen}}">
                <CheckBox Content="连续按 Shift 五次切换粘滞键" IsChecked="{Binding Plan.StickyHotKeyActive}" ToolTip="{Binding DataContext.HelpTips[stickyhotkey],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="使用 Shift 快捷切换时播放提示音" IsChecked="{Binding Plan.StickyHotKeySound}" ToolTip="{Binding DataContext.HelpTips[stickyhotkeysound],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="显示粘滞键任务栏图标" IsChecked="{Binding Plan.StickyIndicator}" ToolTip="{Binding DataContext.HelpTips[stickyindicator],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="按下或释放快捷键时播放提示音" IsChecked="{Binding Plan.StickyAudibleFeedback}" ToolTip="{Binding DataContext.HelpTips[stickyaudible],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="连续按两次时锁定快捷键" IsChecked="{Binding Plan.StickyTriState}" ToolTip="{Binding DataContext.HelpTips[stickytristate],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <CheckBox Content="同时按下两个键时关闭粘滞键" IsChecked="{Binding Plan.StickyTwoKeysOff}" ToolTip="{Binding DataContext.HelpTips[stickytwokeysoff],RelativeSource={RelativeSource AncestorType=Window}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding StickyKeysSummary,StringFormat='　　{0}'}" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　粘滞键是键盘辅助功能，方便依次输入组合快捷键。自定义选项不会自动开启粘滞键；设置影响新建用户和登录界面，不调整筛选键或切换键。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　禁用后将失去此键盘辅助功能及 Shift 快捷切换，需要辅助输入的用户请谨慎选择。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsStickyKeysDisabled,Converter={StaticResource VisibleWhen}}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="鼠标" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox Content="关闭鼠标“提高指针精确度”" IsChecked="{Binding Plan.DisablePointerPrecision}" ToolTip="{Binding DataContext.HelpTips[pointerprecision],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　减少 Windows 鼠标加速，不调整 DPI、指针速度或游戏内设置。只配置安装后的新建用户；默认遵循 Windows，驱动和应用可能另有独立设置。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="版本与密钥" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="安装版本与产品密钥" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　Windows 10 / 11 由安装介质决定；密钥用于选择其中的 SKU。目标分区可在“镜像与分区”页配置。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
                <TextBlock Text="版本与密钥方式" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[edition],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox SelectedValue="{Binding Plan.EditionMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[edition],RelativeSource={RelativeSource AncestorType=Window}}">
                  <ComboBoxItem Content="按 SKU 使用通用安装密钥">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="按 SKU 使用通用安装密钥" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="选择 SKU 后使用公开安装密钥。它不提供激活授权，镜像须包含相应 SKU。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="指定自己的产品密钥">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="指定自己的产品密钥" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="使用输入的密钥安装，并写入激活配置。另行指定激活密钥时，激活阶段使用另行指定的密钥。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="安装时输入密钥">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="安装时输入密钥" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="安装程序会显示密钥输入界面，继续按安装流程选择版本。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
