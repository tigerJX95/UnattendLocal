                <WrapPanel><Button Content="载入示例" Tag="wallpaper" Click="ImageScriptExampleClick" ToolTip="{Binding DataContext.HelpTips[imageexample],RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel>
              </DockPanel>
              <TextBox x:Name="WallpaperImageEditor" Text="{Binding Plan.WallpaperImageScript,UpdateSourceTrigger=PropertyChanged}" local:ExampleText.Value="{Binding DesktopImageExample}" Style="{StaticResource ExampleEditor}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[wallpaperimage],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　淡色示例不参与生成。切换模式保留脚本；网络下载需要安装时已有可用网络，脚本中的凭据需自行核对。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　背景在每位用户首次登录时应用。切回默认时保留选色和脚本，停止写入本组覆盖；不会更改本工具的浅深主题。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
          </StackPanel></Border>
