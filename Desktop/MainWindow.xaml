              <TextBox x:Name="LockScreenImageEditor" Text="{Binding Plan.LockScreenImageScript,UpdateSourceTrigger=PropertyChanged}" local:ExampleText.Value="{Binding LockScreenImageExample}" Style="{StaticResource ExampleEditor}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[lockscreenimage],RelativeSource={RelativeSource AncestorType=Window}}"/>
