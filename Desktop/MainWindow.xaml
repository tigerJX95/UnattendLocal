              <CheckBox x:Name="SettingAnchor136" Content="启用讲述人辅助安装" IsChecked="{Binding Plan.UseNarrator}" ToolTip="{Binding DataContext.HelpTips[narrator],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在 PE、系统安装阶段及每位用户首次登录时启动讲述人。默认不勾选；需介质支持讲述人、语音和音频。不会自动关闭朗读。" Foreground="{DynamicResource SecondaryBrush}"/>
