              </DockPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　直接输入其他颜色时，常用色列表不选中。纯色背景会替换背景图片的显示方式，不删除图片文件。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
