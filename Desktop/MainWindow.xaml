              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认模式不覆盖系统策略；自定义起点为 10 次 / 10 分钟 / 10 分钟，仅启用自定义时生效。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
