                <CheckBox x:Name="SettingAnchor140" Content="保留安装隐私文件（应答文件 / Wi-Fi 配置）" IsChecked="{Binding Plan.KeepSensitiveFiles}" ToolTip="{Binding DataContext.HelpTips[sensitivefiles],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认在首次管理员登录阶段清理。选择保留时，下列文件可能包含密码或产品密钥：" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="C:\Windows\Panther\unattend.xml&#10;C:\Windows\Panther\unattend-original.xml&#10;C:\Windows\Setup\Scripts\Wifi.xml" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　安装介质上的原始 XML 需另行保管。" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="应用移除" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20">
