              <StackPanel>
                <TextBlock Text="检查与导出" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　导出前重新检查当前配置。XML 可能包含账户及 Wi-Fi 凭据；预览默认遮蔽密码。" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding XmlImportSummary,StringFormat='　　{0}'}" Visibility="{Binding HasImportedXml,Converter={StaticResource VisibleWhen}}" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　导入的原 XML 含磁盘配置或 Windows PE 命令；下方磁盘设置仅涵盖已还原的部分，请核对原文件的全部操作范围。" Visibility="{Binding HasImportedXmlRisk,Converter={StaticResource VisibleWhen}}" Foreground="{DynamicResource WarningBrush}"/>

                <local:ConfigurationSummaryView Summary="{Binding ConfigurationSummary}" ShowDetails="False" Margin="0,0,0,0"/>
                <Border Margin="0,0,0,16">
                  <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="14"/></DataTrigger></Style.Triggers>
                  </Style></Border.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,16,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="目标磁盘与操作"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Text" Value="危险磁盘操作"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding DiskRisk}" FontSize="14" TextWrapping="Wrap" LineHeight="22">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <Button Content="检查与预览" Click="PreviewClick" HorizontalAlignment="Left" />
                <TextBox Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                <Button Content="导出 autounattend.xml" Click="ExportClick" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
