              </DockPanel>
              <TextBox x:Name="WallpaperImageEditor" Text="{Binding Plan.WallpaperImageScript,UpdateSourceTrigger=PropertyChanged}" local:ExampleText.Value="{Binding DesktopImageExample}" Style="{StaticResource ExampleEditor}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[wallpaperimage],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　淡色示例不参与生成。切换模式保留脚本；网络下载需要安装时已有可用网络，脚本中的凭据需自行核对。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　背景在每位用户首次登录时应用。切回默认时保留选色和脚本，停止写入本组覆盖；不会更改本工具的浅深主题。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor228" Text="锁屏图片" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[lockscreen],RelativeSource={RelativeSource AncestorType=Window}}"/>
            <ComboBox x:Name="SettingAnchor229" SelectedValue="{Binding Plan.LockScreenMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[lockscreen],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="使用 Windows 默认锁屏"/><ComboBoxItem Content="使用锁屏图片（脚本加载）"/></ComboBox>
            <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding LockScreenSummary,StringFormat='　　{0}'}" Foreground="{DynamicResource SecondaryBrush}"/>
            <StackPanel Visibility="{Binding IsScriptLockScreen,Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在安装阶段读取图片，脚本需返回原始字节，不是路径。示例需要安装时可读取的 lockscreen.jpg。" Foreground="{DynamicResource SecondaryBrush}"/>
              <DockPanel LastChildFill="True" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" Content="复制示例" Command="{x:Static local:ExampleText.CopyCommand}" CommandParameter="{Binding ElementName=LockScreenImageEditor}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=LockScreenImageEditor,Path=(local:ExampleText.CopyStatus)}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource SecondaryBrush}"/>
                <WrapPanel><Button Content="载入示例" Tag="lockscreen" Click="ImageScriptExampleClick" ToolTip="{Binding DataContext.HelpTips[imageexample],RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel>
              </DockPanel>
              <TextBox x:Name="LockScreenImageEditor" Text="{Binding Plan.LockScreenImageScript,UpdateSourceTrigger=PropertyChanged}" local:ExampleText.Value="{Binding LockScreenImageExample}" Style="{StaticResource ExampleEditor}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[lockscreenimage],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　锁屏效果受 Windows 版本、版本类型及策略影响，不能保证家庭版或普通专业版生效，部分策略可能限制用户更换锁屏。" Foreground="{DynamicResource WarningBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　切回默认会保留脚本，但不写入新的图片覆盖；不会自动撤销已安装系统的设置。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="自定义脚本" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor231" Text="按安装阶段执行脚本" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　System → DefaultUser → FirstLogon；UserOnce 在每个用户首次登录时运行。同阶段按下方列表顺序执行。各阶段包含工具生成的其他命令，自定义脚本不能替代其执行流程。" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　这些是 Windows 安装与登录阶段，不是 Sysprep 封装前后的钩子。首次登录不保证桌面已加载完成。脚本按原样嵌入应答文件；请自行核对权限、路径、网络、等待安装程序结束以及错误处理。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
            <WrapPanel><Button Content="添加脚本" Click="AddScriptClick"/><Button Content="复制脚本" Click="DuplicateScriptClick"/><Button Content="删除脚本" Click="RemoveScriptClick"/><Button Content="上移脚本" Tag="up" Click="MoveScriptClick"/><Button Content="下移脚本" Tag="down" Click="MoveScriptClick"/></WrapPanel>
            <ListBox ItemsSource="{Binding Plan.Scripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Label" MaxHeight="170" MinHeight="65"/>
            <StackPanel DataContext="{Binding SelectedScript}" Margin="0,12,0,0">
              <CheckBox Content="启用此脚本（关闭时保留内容，不参与生成）" IsChecked="{Binding Enabled}"/>
              <TextBlock Text="执行阶段"/>
              <ComboBox ToolTip="{Binding DataContext.HelpTips[customscripts],RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Phase}" SelectedValuePath="Tag"><ComboBoxItem Content="系统安装时（System）" Tag="System"/><ComboBoxItem Content="默认用户配置（DefaultUser）" Tag="DefaultUser"/><ComboBoxItem Content="全机首次登录（FirstLogon）" Tag="FirstLogon"/><ComboBoxItem Content="每个用户首次登录（UserOnce）" Tag="UserOnce"/></ComboBox>
              <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Text="脚本格式（DefaultUser 仅支持 CMD / PowerShell / REG）" Margin="0,8,0,0"/>
              <ComboBox ToolTip="{Binding DataContext.HelpTips[customscripts],RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding Type}" SelectedValuePath="Tag"><ComboBoxItem Content="PowerShell（.ps1）" Tag="Ps1"/><ComboBoxItem Content="命令脚本（.cmd）" Tag="Cmd"/><ComboBoxItem Content="注册表（.reg）" Tag="Reg"/><ComboBoxItem Content="VBScript（.vbs）" Tag="Vbs"/></ComboBox>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　脚本内容：淡色内容只作参考，不参与生成。支持每个阶段最多 15 条，总计最多 60 条。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <DockPanel LastChildFill="True" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="复制示例" Command="{x:Static local:ExampleText.CopyCommand}" CommandParameter="{Binding ElementName=ScriptExampleEditor}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ScriptExampleEditor,Path=(local:ExampleText.CopyStatus)}" VerticalAlignment="Center" Margin="8,0" MaxWidth="220" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
                <TextBlock Text="脚本内容" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBox x:Name="ScriptExampleEditor" ToolTip="{Binding DataContext.HelpTips[scriptcontent],RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding Content,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExampleEditor}" local:ExampleText.Value="{Binding Example}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False"/>
            </StackPanel>
            <CheckBox x:Name="SettingAnchor232" Content="每个用户首次登录脚本结束后，重启资源管理器" IsChecked="{Binding Plan.RestartExplorerAfterScripts}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　示例：点击后新增一条对应阶段的脚本，默认关闭，请核对效果后启用。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
            <WrapPanel><Button Content="目录命令示例" Tag="directory" Click="CustomScriptExampleClick"/><Button Content="网络配置示例" Tag="network" Click="CustomScriptExampleClick"/></WrapPanel>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　目录示例：System / CMD，设置 DIRCMD 默认参数。网络示例：FirstLogon / PowerShell，将 Ethernet* 的网络类型改为专用；需核对网卡名称。脚本中的密码、令牌也会随方案与 XML 明文保存，凭据省略功能不解析脚本，预览不保证遮蔽脚本中的秘密。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="检查与导出" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="ExportPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SettingAnchor233" Text="检查与导出" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　导出前重新检查当前配置。XML 可能包含账户及 Wi-Fi 凭据；预览默认遮蔽密码。" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding XmlImportSummary,StringFormat='　　{0}'}" Visibility="{Binding HasImportedXml,Converter={StaticResource VisibleWhen}}" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　导入的原 XML 含磁盘配置或 Windows PE 命令；下方磁盘设置仅涵盖已还原的部分，请核对原文件的全部操作范围。" Visibility="{Binding HasImportedXmlRisk,Converter={StaticResource VisibleWhen}}" Foreground="{DynamicResource WarningBrush}"/>

                <local:ConfigurationSummaryView Summary="{Binding ConfigurationSummary}" ShowDetails="False" Margin="0,0,0,0"/>
                <Border Margin="0,0,0,16">
                  <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="14"/></DataTrigger></Style.Triggers>
                  </Style></Border.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,16,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="目标磁盘与操作"/><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Text" Value="危险磁盘操作"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding DiskRisk}" FontSize="14" TextWrapping="Wrap" LineHeight="22">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDestructiveDisk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <Button Content="检查与预览" Click="PreviewClick" HorizontalAlignment="Left" />
                <TextBox Text="{Binding Preview,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                <Button Content="导出 autounattend.xml" Click="ExportClick" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
