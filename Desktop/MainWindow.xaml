              <CheckBox x:Name="SettingAnchor137" Content="关闭 C 盘系统还原" IsChecked="{Binding Plan.DisableSystemRestore}" ToolTip="{Binding DataContext.HelpTips[systemrestore],RelativeSource={RelativeSource AncestorType=Window}}"/>
