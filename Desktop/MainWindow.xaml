              <TextBlock Style="{StaticResource ExplanationText}" Text="　　只影响目标安装系统；取消勾选只影响新配置，不撤销已安装系统的设置。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border x:Name="InstallationOptions" Style="{StaticResource Card}">
