                <CheckBox Content="首次自动登录第一个管理员账户一次" IsEnabled="{Binding IsAutomaticAccounts}" IsChecked="{Binding Plan.AutoLogon}" ToolTip="{Binding DataContext.HelpTips[logon],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="密码到期（Windows 默认：42 天）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[expiration],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox IsEnabled="{Binding IsAutomaticAccounts}" SelectedValue="{Binding Plan.PasswordExpiration}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[expiration],RelativeSource={RelativeSource AncestorType=Window}}">
                  <ComboBoxItem Content="永不过期">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="永不过期" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="本地账户密码不按天数到期。此设置不会清空密码，也不等于允许空密码。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="Windows 默认">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="Windows 默认" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="使用 Windows 默认密码到期策略，通常为 42 天；本工具不额外覆盖系统默认策略。只适用于本地账户。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="指定天数">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="指定天数" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="在下方填写 1–999 天，设置本地账户密码的最大使用天数。内置 Administrator 密码永不过期。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <TextBlock Text="指定天数（1–999，仅指定天数模式生效）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[expiration],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox IsEnabled="{Binding IsPasswordDays}" Text="{Binding Plan.PasswordDays,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[expiration],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Visibility="{Binding NeedsRetentionConsent,Converter={StaticResource VisibleWhen}}" Text="　　关闭首次自动登录时，请在 OOBE 页明确选择保留安装隐私文件。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
                <Button Content="安装脚本与隐私文件设置…" Click="InstallationOptionsClick" HorizontalAlignment="Left" />
                <CheckBox Content="在应答文件中使用 Base64 隐藏账户密码" IsEnabled="{Binding IsAutomaticAccounts}" IsChecked="{Binding Plan.ObscurePasswords}" ToolTip="{Binding DataContext.HelpTips[secrets],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Base64 是可还原的编码，不是加密。" Foreground="{DynamicResource WarningBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="账户锁定策略" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[accountlockout],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <ComboBox SelectedValue="{Binding Plan.AccountLockoutMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[accountlockout],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="使用 Windows 默认策略"/><ComboBoxItem Content="禁用账户锁定"/><ComboBoxItem Content="自定义账户锁定策略"/></ComboBox>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认模式不覆盖系统策略；自定义起点为 10 次 / 10 分钟 / 10 分钟，仅启用自定义时生效。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <StackPanel IsEnabled="{Binding IsCustomAccountLockout}" Visibility="{Binding IsCustomAccountLockout,Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="登录失败次数（0–999，0 表示禁用锁定）"/>
                <TextBox Text="{Binding Plan.LockoutThreshold,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[lockoutthreshold],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="失败计数重置等待时间（1–99999 分钟）"/>
                <TextBox Text="{Binding Plan.LockoutResetMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[lockoutreset],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="锁定持续时间（1–99999 分钟）"/>
                <TextBox Text="{Binding Plan.LockoutDurationMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[lockoutduration],RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　失败计数重置等待时间不得大于锁定持续时间；输入不完整或无效时不能导出。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　禁用账户锁定会降低防密码试探能力，请结合设备用途及组织安全要求选择。自定义失败次数为 0 时也会禁用锁定。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="{Binding IsAccountLockoutDisabled,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Text="{Binding AccountLockoutSummary}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　配置本机账户策略，不修改微软在线账户或域端认证服务的锁定规则；组织策略可能覆盖本机配置。不会修改当前电脑。" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="网络" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="安装网络" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="网络配置方式" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[wifi],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox SelectedValue="{Binding Plan.WifiMode}" SelectedValuePath="Tag" ToolTip="{Binding DataContext.HelpTips[wifi],RelativeSource={RelativeSource AncestorType=Window}}">
                  <ComboBoxItem Content="有线局域网（跳过 Wi-Fi 配置）" Tag="隐藏无线网络选择页">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="隐藏无线网络选择页" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="跳过无线网络选择，适合已有有线连接的情况。不会断开已有网络，也不等于允许离线安装。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="安装时手动选择" Tag="安装时手动选择">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="安装时手动选择" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="保留安装时的无线网络选择引导。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="预设 WPA2 Wi-Fi" Tag="预设 WPA2 Wi-Fi">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="预设 WPA2 Wi-Fi" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="使用本页 SSID 和密码生成 WPA2-Personal 配置，需安装镜像包含相应网卡驱动。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <StackPanel IsEnabled="{Binding IsPresetWifi}">
                  <TextBlock Text="Wi-Fi 名称（SSID）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBox Text="{Binding Plan.Ssid,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock Text="Wi-Fi 密码" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <PasswordBox x:Name="WifiPassword" PasswordChanged="WifiPasswordChanged" ToolTip="{Binding DataContext.HelpTips[ssid],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <CheckBox Content="隐藏网络" IsChecked="{Binding Plan.HiddenWifi}" ToolTip="{Binding DataContext.HelpTips[hidden],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <CheckBox Content="自动连接预设 Wi-Fi" IsChecked="{Binding Plan.ConnectWifi}" ToolTip="{Binding DataContext.HelpTips[hidden],RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <CheckBox Content="允许 Windows 11 在无网络时安装" IsEnabled="{Binding CanBypassNetwork}" IsChecked="{Binding Plan.BypassNetwork}" ToolTip="{Binding DataContext.HelpTips[offline],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　有线局域网默认通过 DHCP 获取地址；跳过 Wi-Fi 配置。仅局域网、无互联网时可允许离线安装。微软账户模式需要联网，并取消允许离线安装。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="OOBE" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" x:Name="OobePage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="首次开机引导（OOBE）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="快捷隐私设置" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[privacy],RelativeSource={RelativeSource AncestorType=Window}}" />
                <ComboBox SelectedValue="{Binding Plan.PrivacyMode}" SelectedValuePath="Tag" ToolTip="{Binding DataContext.HelpTips[privacy],RelativeSource={RelativeSource AncestorType=Window}}">
                  <ComboBoxItem Content="全部关闭（OOBE 隐私选项选择否）" Tag="关闭快捷隐私设置">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="关闭快捷隐私设置" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="关闭相应快捷隐私选项；具体效果取决于目标 Windows 版本。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="安装时手动选择" Tag="安装时手动选择">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="安装时手动选择" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="保留安装时的隐私设置引导，可逐项选择。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="全部开启" Tag="启用快捷设置">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="启用快捷设置" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="启用相应快捷设置，可能开启更多数据共享和个性化选项。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <CheckBox Content="隐藏在线账户页面" IsEnabled="{Binding CanHideOnlineAccount}" IsChecked="{Binding Plan.HideOnlineAccount}" ToolTip="{Binding DataContext.HelpTips[online],RelativeSource={RelativeSource AncestorType=Window}}" />
                <CheckBox Content="隐藏许可协议页面" IsChecked="{Binding Plan.HideEula}" ToolTip="{Binding DataContext.HelpTips[eula],RelativeSource={RelativeSource AncestorType=Window}}" />
                <CheckBox Content="隐藏 OEM 注册页面" IsChecked="{Binding Plan.HideOEMRegistration}" ToolTip="{Binding DataContext.HelpTips[oem],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　OOBE 自动化需同时预设本地账户、语言区域和网络，关闭快捷隐私设置，并隐藏相关页面。默认手动选择安装分区；自动安装需明确配置目标磁盘和镜像。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="设备加密" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <CheckBox Content="禁止 BitLocker 自动设备加密" IsChecked="{Binding Plan.PreventDeviceEncryption}" ToolTip="{Binding DataContext.HelpTips[deviceencryption],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　新建推荐与自定义配置默认勾选，阻止 Windows 自动启用设备加密。取消后遵循 Windows 默认行为；已有加密卷不会因此解密，安装后仍可手动配置 BitLocker。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="远程与脚本管理（高级）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox Content="启用远程桌面接入（RDP）" IsChecked="{Binding Plan.EnableRemoteDesktop}" ToolTip="{Binding DataContext.HelpTips[remotedesktop],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　开启目标 Windows 的远程桌面接入与内置防火墙规则。家庭版不提供接入主机能力，此选项不会绕过版本限制；不自动添加允许用户。默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　其他设备将可尝试远程连接；请使用可信网络、有效账户和强密码。网络级别身份验证保持原有设置，不创建路由器端口转发。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.EnableRemoteDesktop,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox Content="允许 Windows PowerShell 脚本（RemoteSigned）" IsChecked="{Binding Plan.AllowPowerShellScripts}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[pspolicy],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　将 LocalMachine 策略设为 RemoteSigned，允许本地脚本；带互联网来源标记的脚本通常需要可信签名。组织、用户或会话策略可覆盖。与隐藏窗口和自定义脚本开关独立，默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　两项均在目标 Windows 安装时设置，不修改本机。取消勾选只影响新生成配置，不撤销已安装系统上的设置。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Text="系统常用设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox Content="禁用快速启动" IsChecked="{Binding Plan.DisableFastStartup}" ToolTip="{Binding DataContext.HelpTips[faststartup],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认遵循 Windows；勾选后关闭目标系统的快速启动，关机后的开机可能变慢。休眠功能保持原有设置。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="启用长路径支持" IsChecked="{Binding Plan.EnableLongPaths}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[longpaths],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　允许支持长路径的应用处理较深的目录；旧程序仍可能受限制，单个文件名长度限制不变。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="关闭系统声音" IsChecked="{Binding Plan.TurnOffSystemSounds}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[systemsounds],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　关闭系统提示音方案与系统启动声音，不影响音乐、视频和应用音频。未勾选时遵循 Windows 默认行为。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="禁用重启后的最后用户自动登录" IsChecked="{Binding Plan.DisableAutomaticRestartSignOn}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[restartsignon],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　阻止重启后自动登录最后用户并锁定会话；安装后首次自动登录仍按“用户与密码”页的设置执行。默认遵循 Windows。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="阻止硬件关联应用自动安装" IsChecked="{Binding Plan.PreventDeviceApps}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[deviceapps],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　阻止自动获取设备元数据及协同安装程序；不卸载已有软件，不等于全面禁止驱动安装。默认遵循 Windows。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　可能影响厂商附加功能或协同安装流程，请保留所需驱动与软件的安装方式。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.PreventDeviceApps,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox Content="清理空 Windows.old 文件夹" IsChecked="{Binding Plan.DeleteWindowsOld}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[windowsold],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在首次登录阶段尝试删除 C:\Windows.old 空目录；非空目录保留，不递归删除旧系统文件。默认不添加清理命令。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="禁用应用建议和自动推广" IsChecked="{Binding Plan.DisableAppSuggestions}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[appsuggestions],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　减少系统应用建议与自动推广安装；不卸载已有应用，不阻止主动安装。默认遵循 Windows 与组织策略。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　此项可能影响“移动设备”中的“管理设备”入口，需要相关功能时请谨慎选择。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableAppSuggestions,Converter={StaticResource VisibleWhen}}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Windows 更新" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox Content="循环暂停 Windows 更新（每次暂停 7 天）" IsChecked="{Binding Plan.DisableWindowsUpdate}" ToolTip="{Binding DataContext.HelpTips[windowsupdate],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认不勾选，遵循 Windows 与组织策略。启用后通过计划任务反复延长暂停期，不会停用更新服务。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　长期暂停会延迟安全补丁和质量更新，请结合设备用途安排更新维护。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableWindowsUpdate,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　临时更新可在 Windows 更新设置中选择“恢复更新”；要永久恢复，请先在任务计划程序中禁用或删除 PauseWindowsUpdate，再恢复更新。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Microsoft Edge" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox Content="跳过 Edge 首次运行引导" IsChecked="{Binding Plan.HideEdgeFre}" ToolTip="{Binding DataContext.HelpTips[edgefre],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　跳过首次欢迎引导；不阻止账户登录，仍可能出现同步确认等提示。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="关闭 Edge 启动加速及后台运行" IsChecked="{Binding Plan.DisableEdgeStartupBoost}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[edgebackground],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　两项默认设为关闭，用户安装后仍可在 Edge 中调整；浏览器启动速度可能变慢。未勾选时遵循 Edge 默认行为。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border x:Name="InstallationOptions" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="安装脚本与隐私文件" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <CheckBox Content="隐藏安装过程中的 PowerShell 窗口" IsChecked="{Binding Plan.HidePowerShellWindows}" ToolTip="{Binding DataContext.HelpTips[powershell],RelativeSource={RelativeSource AncestorType=Window}}" />
