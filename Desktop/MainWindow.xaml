                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="安装时手动选择" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="保留安装时的隐私设置引导，可逐项选择。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="全部开启" Tag="启用快捷设置">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="启用快捷设置" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="启用相应快捷设置，可能开启更多数据共享和个性化选项。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="SettingAnchor092" Content="隐藏在线账户页面" IsEnabled="{Binding CanHideOnlineAccount}" IsChecked="{Binding Plan.HideOnlineAccount}" ToolTip="{Binding DataContext.HelpTips[online],RelativeSource={RelativeSource AncestorType=Window}}" />
                <CheckBox x:Name="SettingAnchor093" Content="隐藏许可协议页面" IsChecked="{Binding Plan.HideEula}" ToolTip="{Binding DataContext.HelpTips[eula],RelativeSource={RelativeSource AncestorType=Window}}" />
                <CheckBox x:Name="SettingAnchor094" Content="隐藏 OEM 注册页面" IsChecked="{Binding Plan.HideOEMRegistration}" ToolTip="{Binding DataContext.HelpTips[oem],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　OOBE 自动化需同时预设本地账户、语言区域和网络，关闭快捷隐私设置，并隐藏相关页面。默认手动选择安装分区；自动安装需明确配置目标磁盘和镜像。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SettingAnchor095" Text="设备加密" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <CheckBox x:Name="SettingAnchor096" Content="禁止 BitLocker 自动设备加密" IsChecked="{Binding Plan.PreventDeviceEncryption}" ToolTip="{Binding DataContext.HelpTips[deviceencryption],RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　新建推荐与自定义配置默认勾选，阻止 Windows 自动启用设备加密。取消后遵循 Windows 默认行为；已有加密卷不会因此解密，安装后仍可手动配置 BitLocker。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor097" Text="虚拟机集成工具" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　按目标虚拟机平台选择，默认均不勾选。安装前挂载对应的官方工具介质，确保安装器与目标 Windows 及架构兼容；本工具不附带安装器，也不联网下载。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor098" Content="安装 VMware Tools" IsChecked="{Binding Plan.VMwareTools}" Margin="0,10,0,0" ToolTip="{Binding DataContext.HelpTips[vmwaretools],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　从已挂载的 VMware Tools 光盘查找产品名为 VMware Tools 的 setup.exe，在全机首次登录阶段静默安装。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor099" Content="安装 VirtualBox 增强功能" IsChecked="{Binding Plan.VBoxGuestAdditions}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[vboxtools],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　挂载 VBoxGuestAdditions.iso；从光盘导入工具证书并运行 VBoxWindowsAdditions.exe 静默安装。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor100" Content="安装 VirtIO Guest Tools（KVM / QEMU）" IsChecked="{Binding Plan.VirtIoGuestTools}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[virtiotools],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　挂载 virtio-win 工具介质，在全机首次登录阶段运行 virtio-win-guest-tools.exe。此项不替代 Windows PE 阶段需要的存储或网络驱动。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor101" Content="安装 Parallels Tools" IsChecked="{Binding Plan.ParallelsTools}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[parallelstools],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　挂载 Parallels Tools 光盘，从光盘运行 PTAgent.exe 静默安装；部分集成功能可能需要重启。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　仅在目标安装过程中执行，不修改当前电脑。未找到介质时，安装脚本输出提示而不安装；取消只影响新生成配置，不卸载已安装工具。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor102" Text="权限与固件程序（高级）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor103" Content="关闭用户账户控制（UAC）" IsChecked="{Binding Plan.DisableUac}" ToolTip="{Binding DataContext.HelpTips[uac],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　沿用原生成器设置 EnableLUA=0，关闭目标系统的 UAC。默认不勾选，遵循 Windows 默认设置。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　会降低管理员权限提升保护；这不是仅隐藏提示，可能影响依赖 UAC 的应用。请根据目标用途选择。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableUac,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor104" Content="阻止 WPBT 固件程序执行" IsChecked="{Binding Plan.DisableWpbt}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[wpbt],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　设置 DisableWpbtExecution=1，阻止 Windows 执行通过 Windows Platform Binary Table 提供的固件程序。默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　可能影响厂商通过该机制提供的软件；不卸载已有应用，不修改 BIOS/UEFI 固件，也不等于全面阻止厂商软件安装。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableWpbt,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　两项只在目标 Windows 安装阶段设置，不修改当前电脑。取消勾选只影响新配置，不撤销已安装系统的设置。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor105" Text="AppLocker 应用控制策略" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor106" Content="应用 AppLocker 策略 XML" IsChecked="{Binding Plan.UseAppLocker}" ToolTip="{Binding DataContext.HelpTips[applocker],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认关闭。规则的审核或强制模式由 XML 决定；结构检查不能判断规则是否适合目标电脑。策略始终保存在方案中，分享前核对路径、SID 及其他信息。" Foreground="{DynamicResource SecondaryBrush}"/>
              <StackPanel IsEnabled="{Binding Plan.UseAppLocker}">
                <WrapPanel><Button Content="导入策略 XML" Click="ImportAppLockerClick"/><Button Content="检查策略结构" Click="ValidateAppLockerClick"/><Button Content="载入审核示例" Click="AppLockerExampleClick"/></WrapPanel>
                <TextBox x:Name="SettingAnchor107" Text="{Binding Plan.AppLockerPolicyXml,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Height="220" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[applocker],RelativeSource={RelativeSource AncestorType=Window}}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　会启动 AppIDSvc 并应用策略，不带 -Merge，可能替换现有本地策略。强制策略可能拦截安装脚本、系统工具或管理员应用，请先在虚拟机审核并准备恢复方案；取消勾选不恢复已安装系统。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.UseAppLocker,Converter={StaticResource VisibleWhen}}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor108" Text="应用与内核保护、系统盘权限" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　以下均为可选的目标安装设置，默认不勾选。不勾选表示不添加覆盖，遵循 Windows 和组织策略；本工具不修改当前电脑。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor109" Content="关闭智能应用控制（SAC）" IsChecked="{Binding Plan.DisableSac}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[sac],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　Windows 11 的应用信任保护。关闭后可能需要重置或重装才能恢复，请勿当作临时暂停。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　会降低对不受信任应用的保护。取消勾选仅改变新配置，不重新启用已安装系统的智能应用控制。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableSac,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor110" Content="关闭 Windows 与 Edge 的 SmartScreen" IsChecked="{Binding Plan.DisableSmartScreen}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[smartscreen],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　关闭 Windows / Edge 的相关信誉、钓鱼及密码风险提示，并隐藏安全中心托盘图标；不关闭 Defender 防病毒引擎。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　会降低恶意网站、下载和应用的信誉检查保护，也会减少安全状态可见性。取消不恢复已安装系统。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableSmartScreen,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor111" Content="关闭核心隔离（VBS / 内存完整性）" IsChecked="{Binding Plan.DisableCoreIsolation}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[coreisolation],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在安装阶段设置 VBS 与内存完整性相关项为关闭；不卸载 Hyper-V、WSL2 或虚拟机工具，不保证性能提升。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　会降低基于虚拟化的内核保护，可能影响依赖 VBS 的安全能力；驱动或虚拟机兼容性应先检查支持情况。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableCoreIsolation,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor112" Content="收紧 C 盘根目录写入权限" IsChecked="{Binding Plan.HardenSystemDriveAcl}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[rootacl],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　从 C 盘根目录移除 Authenticated Users 组的显式允许权限；非递归操作，可能影响依赖普通用户在根目录创建文件夹的程序。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　只收紧指定组在 C 盘根目录的权限，不重设整个磁盘 ACL，也不替代用户权限管理；取消不还原已安装系统权限。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.HardenSystemDriveAcl,Converter={StaticResource VisibleWhen}}"/>
</StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor113" Text="进程创建审计（高级）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <ComboBox x:Name="SettingAnchor114" ItemsSource="{Binding ProcessAuditModes}" SelectedItem="{Binding Plan.ProcessAuditMode}" ToolTip="{Binding DataContext.HelpTips[processaudit],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　启用后在目标 Windows 安全日志中记录进程创建事件（4688），便于排查程序启动行为；不记录程序的屏幕或文件内容，也不生成程序运行报告。默认不配置。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　“启用审计”只设置审计策略，不强制关闭已有命令行记录策略。实际行为可能受组织策略覆盖。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　记录命令行会将参数明文写入安全日志，可能包含密码、密钥或令牌；有权读取安全日志的人可以查看。请结合用途选择。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsAuditCommandLine,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　只在目标安装阶段设置，不修改当前电脑；切回默认仅影响新配置，不关闭已安装系统的审计或删除已有日志。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor115" Text="远程与脚本管理（高级）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor116" Content="启用远程桌面接入（RDP）" IsChecked="{Binding Plan.EnableRemoteDesktop}" ToolTip="{Binding DataContext.HelpTips[remotedesktop],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　开启目标 Windows 的远程桌面接入与内置防火墙规则。家庭版不提供接入主机能力，此选项不会绕过版本限制；不自动添加允许用户。默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　其他设备将可尝试远程连接；请使用可信网络、有效账户和强密码。网络级别身份验证保持原有设置，不创建路由器端口转发。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.EnableRemoteDesktop,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor117" Content="允许 Windows PowerShell 脚本（RemoteSigned）" IsChecked="{Binding Plan.AllowPowerShellScripts}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[pspolicy],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　将 LocalMachine 策略设为 RemoteSigned，允许本地脚本；带互联网来源标记的脚本通常需要可信签名。组织、用户或会话策略可覆盖。与隐藏窗口和自定义脚本开关独立，默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　两项均在目标 Windows 安装时设置，不修改本机。取消勾选只影响新生成配置，不撤销已安装系统上的设置。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock x:Name="SettingAnchor118" Text="系统常用设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor119" Content="禁用快速启动" IsChecked="{Binding Plan.DisableFastStartup}" ToolTip="{Binding DataContext.HelpTips[faststartup],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认遵循 Windows；勾选后关闭目标系统的快速启动，关机后的开机可能变慢。休眠功能保持原有设置。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor120" Content="禁用 NTFS 最后访问时间更新" IsChecked="{Binding Plan.DisableLastAccess}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[lastaccess],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　沿用原生成器的 fsutil 设置，停止 NTFS 最后访问时间更新；创建时间和修改时间保持。默认不勾选，不修改当前电脑。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　依赖最后访问时间的归档、备份或清理规则可能受影响；不会删除文件。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableLastAccess,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor121" Content="删除旧版兼容联接点（高级）" IsChecked="{Binding Plan.DeleteJunctions}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[junctions],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　首次登录时删除指定目录范围内的重解析点，可能影响旧软件或自建链接；默认关闭，不修改本机。" Foreground="{DynamicResource WarningBrush}"/>
              <CheckBox x:Name="SettingAnchor122" Content="启用长路径支持" IsChecked="{Binding Plan.EnableLongPaths}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[longpaths],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　允许支持长路径的应用处理较深的目录；旧程序仍可能受限制，单个文件名长度限制不变。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor123" Content="关闭系统声音" IsChecked="{Binding Plan.TurnOffSystemSounds}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[systemsounds],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　关闭系统提示音方案与系统启动声音，不影响音乐、视频和应用音频。未勾选时遵循 Windows 默认行为。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor124" Content="禁用重启后的最后用户自动登录" IsChecked="{Binding Plan.DisableAutomaticRestartSignOn}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[restartsignon],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　阻止重启后自动登录最后用户并锁定会话；安装后首次自动登录仍按“用户与密码”页的设置执行。默认遵循 Windows。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor125" Content="阻止硬件关联应用自动安装" IsChecked="{Binding Plan.PreventDeviceApps}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[deviceapps],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　阻止自动获取设备元数据及协同安装程序；不卸载已有软件，不等于全面禁止驱动安装。默认遵循 Windows。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　可能影响厂商附加功能或协同安装流程，请保留所需驱动与软件的安装方式。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.PreventDeviceApps,Converter={StaticResource VisibleWhen}}"/>
              <CheckBox x:Name="SettingAnchor126" Content="清理空 Windows.old 文件夹" IsChecked="{Binding Plan.DeleteWindowsOld}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[windowsold],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在首次登录阶段尝试删除 C:\Windows.old 空目录；非空目录保留，不递归删除旧系统文件。默认不添加清理命令。" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox x:Name="SettingAnchor127" Content="禁用应用建议和自动推广" IsChecked="{Binding Plan.DisableAppSuggestions}" Margin="0,14,0,0" ToolTip="{Binding DataContext.HelpTips[appsuggestions],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　减少系统应用建议与自动推广安装；不卸载已有应用，不阻止主动安装。默认遵循 Windows 与组织策略。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　此项可能影响“移动设备”中的“管理设备”入口，需要相关功能时请谨慎选择。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.DisableAppSuggestions,Converter={StaticResource VisibleWhen}}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor128" Text="Windows 更新" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor129" Content="减少 Windows 更新自动重启" IsChecked="{Binding Plan.PreventAutomaticReboot}" ToolTip="{Binding DataContext.HelpTips[updaterestart],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　沿用原生成器的更新重启策略和 MoveActiveHours 计划任务，定期调整活动时间。更新仍可下载与安装，与下方循环暂停独立。默认不勾选。" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　不同 Windows 版本、组织策略、更新截止期限或手动安排重启可能覆盖；不保证阻止全部重启。请自行安排重启完成更新。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.PreventAutomaticReboot,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　取消勾选只影响新生成的配置，不移除已安装系统的任务或策略。" Foreground="{DynamicResource SecondaryBrush}"/>
