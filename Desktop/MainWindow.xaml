              <TextBlock Text="常用背景颜色"/>
              <ComboBox ItemsSource="{Binding WallpaperColorChoices}" SelectedValue="{Binding WallpaperColorPreset}" SelectedValuePath="Id" ToolTip="{Binding DataContext.HelpTips[wallpapercolor],RelativeSource={RelativeSource AncestorType=Window}}">
