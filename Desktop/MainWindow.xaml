              </StackPanel>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　禁用账户锁定会降低防密码试探能力，请结合设备用途及组织安全要求选择。自定义失败次数为 0 时也会禁用锁定。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Visibility="{Binding IsAccountLockoutDisabled,Converter={StaticResource VisibleWhen}}"/>
              <TextBlock Text="{Binding AccountLockoutSummary}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　配置本机账户策略，不修改微软在线账户或域端认证服务的锁定规则；组织策略可能覆盖本机配置。不会修改当前电脑。" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
