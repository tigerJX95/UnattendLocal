                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="安装时输入密钥">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="安装时输入密钥" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="安装程序会显示密钥输入界面，继续按安装流程选择版本。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="使用 BIOS/UEFI 固件密钥">
                    <ComboBoxItem.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}">
                        <StackPanel>
                          <TextBlock Text="使用 BIOS/UEFI 固件密钥" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="安装程序使用目标电脑的固件密钥，适合重装预装 Windows 的设备；镜像需匹配其 SKU。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                </ComboBox>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGenericEdition}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="要安装的 SKU" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[sku],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <ComboBox x:Name="SettingAnchor043" ItemsSource="{Binding Editions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Plan.EditionId}" ToolTip="{Binding DataContext.HelpTips[sku],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock Text="对应通用安装密钥（公开密钥）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[sku],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBox Text="{Binding SelectedEditionKey,Mode=OneWay}" FontSize="18" FontWeight="SemiBold" IsReadOnly="True" FontFamily="Consolas" ToolTip="{Binding DataContext.HelpTips[sku],RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomEdition}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="自定义产品密钥（五组，每组五位）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[installkey],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBox x:Name="SettingAnchor044" Text="{Binding Plan.CustomProductKey,UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" ToolTip="{Binding DataContext.HelpTips[installkey],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock Text="密钥未随方案保存，请重新输入。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Plan.NeedsInstallationKey}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding EditionHint,StringFormat='　　{0}'}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SettingAnchor045" Text="激活密钥" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <CheckBox x:Name="SettingAnchor046" Content="单独指定安装后的激活密钥" IsChecked="{Binding Plan.UseActivationKey}" ToolTip="{Binding DataContext.HelpTips[activation],RelativeSource={RelativeSource AncestorType=Window}}" />
                <StackPanel IsEnabled="{Binding Plan.UseActivationKey}">
                  <TextBlock Text="激活密钥（可与安装密钥不同）" Foreground="{DynamicResource SecondaryBrush}" ToolTip="{Binding DataContext.HelpTips[activation],RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBox x:Name="SettingAnchor047" Text="{Binding Plan.ActivationProductKey,UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" ToolTip="{Binding DataContext.HelpTips[activation],RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="激活密钥未随方案保存，请重新输入。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Plan.UseActivationKey}" Value="True" />
                            <Condition Binding="{Binding Plan.NeedsActivationKey}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource ExplanationText}" Text="　　密钥格式检查不能验证授权有效性或 SKU 是否匹配；实际结果由 Windows 安装与激活流程决定。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor048" Text="Windows 11 安装检查" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[hardware],RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　需要在不满足要求的设备上安装 Windows 11 时，可按需勾选。默认不绕过检查。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
              <CheckBox x:Name="SettingAnchor049" Content="绕过 TPM 2.0 检查" IsChecked="{Binding Plan.BypassTPMCheck}" ToolTip="{Binding DataContext.HelpTips[hardwaretpm],RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="SettingAnchor050" Content="绕过安全启动检查" IsChecked="{Binding Plan.BypassSecureBootCheck}" ToolTip="{Binding DataContext.HelpTips[hardwareboot],RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="SettingAnchor051" Content="绕过内存容量检查" IsChecked="{Binding Plan.BypassRAMCheck}" ToolTip="{Binding DataContext.HelpTips[hardwareram],RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　只影响安装阶段的要求检查，不关闭固件中的 TPM 或安全启动；不会增加内存。效果取决于安装镜像，不保证绕过 CPU 指令集等其他要求。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="镜像与分区" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor052" Text="安装介质配置集" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <CheckBox x:Name="SettingAnchor053" Content="使用 $OEM$ 配置集（UseConfigurationSet）" IsChecked="{Binding Plan.UseConfigurationSet}" ToolTip="{Binding DataContext.HelpTips[configset],RelativeSource={RelativeSource AncestorType=Window}}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　默认关闭。需自行准备与应答文件配套的 $OEM$ 目录；$$ 对应 Windows 目录，$1 对应系统盘根目录。本工具不创建、打包或复制介质文件，也不自动安装其中的应用。" Foreground="{DynamicResource SecondaryBrush}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　由 Windows Setup 处理配置集，可能覆盖同路径文件。请核对介质内容；取消不删除已复制文件。自定义 PE 脚本中的复制流程仍需用原工具调整。" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Plan.UseConfigurationSet,Converter={StaticResource VisibleWhen}}"/>
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor054" Text="安装镜像" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　选择安装介质中的镜像，名称 / 索引必须与实际介质匹配。Windows 10 / 11 由镜像决定，产品密钥须匹配 SKU。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
            <ComboBox x:Name="SettingAnchor055" SelectedValue="{Binding Plan.ImageSelection}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[image],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="由安装程序决定"/><ComboBoxItem Content="按镜像名称"/><ComboBoxItem Content="按镜像索引"/></ComboBox>
            <StackPanel IsEnabled="{Binding IsImageName}"><TextBlock Text="完整镜像名称"/><TextBox x:Name="SettingAnchor056" Text="{Binding Plan.ImageName,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.HelpTips[image],RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel>
            <StackPanel IsEnabled="{Binding IsImageIndex}"><TextBlock Text="镜像索引（从 1 开始）"/><TextBox x:Name="SettingAnchor057" Text="{Binding Plan.ImageIndex,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[image],RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　可在 Windows 上用 DISM /Get-ImageInfo /ImageFile:路径查看镜像信息。本版不读取或校验实际镜像内容；名称、索引和密钥冲突可能使安装失败或出现选择页面。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor058" Text="CompactOS 系统文件压缩" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" ToolTip="{Binding DataContext.HelpTips[compactos],RelativeSource={RelativeSource AncestorType=Window}}"/>
            <ComboBox x:Name="SettingAnchor059" SelectedValue="{Binding Plan.CompactOsMode}" SelectedValuePath="Content" IsEnabled="{Binding CanEditCompactOs}" ToolTip="{Binding DataContext.HelpTips[compactos],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="使用 Windows 默认设置"/><ComboBoxItem Content="启用 CompactOS（压缩系统文件）"/><ComboBoxItem Content="禁用 CompactOS（不压缩系统文件）"/></ComboBox>
            <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding CompactOsSummary,StringFormat='　　{0}'}" Foreground="{DynamicResource SecondaryBrush}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　CompactOS 压缩 Windows 系统文件以减少磁盘占用，不压缩整个磁盘，也不改变分区配置。默认由安装程序决定；此项不依赖首次自动登录。" Foreground="{DynamicResource SecondaryBrush}"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　读取压缩文件需要解压，实际性能和节省空间取决于处理器、存储设备及镜像内容。仅配置即将安装的系统，不修改当前电脑。" Foreground="{DynamicResource SecondaryBrush}"/>
            <TextBlock Text="　　导入的 XML 使用自定义安装或压缩脚本，参数已保留；本版暂不能在界面覆盖该脚本的 CompactOS 设置，请用原工具调整后重新导入。" Foreground="{DynamicResource WarningBrush}" ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ExplanationText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanEditCompactOs}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock x:Name="SettingAnchor060" Text="磁盘与分区" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Border Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12"><StackPanel>
              <TextBlock Text="磁盘操作风险与责任提示" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="16"/>
              <TextBlock Style="{StaticResource ExplanationText}"><Run Text="　　"/><Run Text="{x:Static core:DiskSafety.Risk}"/></TextBlock>
              <TextBlock Style="{StaticResource ExplanationText}"><Run Text="　　"/><Run Text="{x:Static core:DiskSafety.Preparation}"/></TextBlock>
              <TextBlock Style="{StaticResource ExplanationText}" Foreground="{DynamicResource SecondaryBrush}"><Run Text="　　"/><Run Text="{x:Static core:DiskSafety.Responsibility}"/></TextBlock>
            </StackPanel></Border>
            <ComboBox x:Name="SettingAnchor061" SelectedValue="{Binding Plan.DiskMode}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[diskmode],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="手动选择磁盘与分区"/><ComboBoxItem Content="使用已有分区"/><ComboBoxItem Content="清空指定磁盘后自动分区"/><ComboBoxItem Content="自定义 DiskPart 脚本"/></ComboBox>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　编号必须是目标电脑在 Windows PE 中的编号，不能按当前电脑或盘符推断。可在目标 WinPE 中用 diskpart 的 list disk、select disk 和 list partition 核对。本工具不扫描或修改当前电脑磁盘。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
            <StackPanel IsEnabled="{Binding IsTargetDisk}"><TextBlock Text="目标磁盘编号（从 0 开始，必须明确填写）"/><TextBox x:Name="SettingAnchor062" Text="{Binding Plan.TargetDiskId,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[disktarget],RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel>
            <StackPanel IsEnabled="{Binding IsPartitionTarget}" Visibility="{Binding IsPartitionTarget,Converter={StaticResource VisibleWhen}}"><TextBlock Text="安装目标分区编号（从 1 开始；脚本模式填写执行后的编号）"/><TextBox x:Name="SettingAnchor063" Text="{Binding Plan.TargetPartitionId,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[disktarget],RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel>
            <StackPanel IsEnabled="{Binding IsExistingDisk}" Visibility="{Binding IsExistingDisk,Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　不格式化也不保证原有文件完整保留。目标分区及现有引导分区必须适合安装镜像和启动方式；本模式不重建或清空其他分区。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
              <CheckBox x:Name="SettingAnchor064" Content="格式化目标已有分区为 NTFS（默认关闭）" IsChecked="{Binding Plan.FormatExistingPartition}" ToolTip="{Binding DataContext.HelpTips[diskformat],RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox Content="我已备份并获得操作授权，确认格式化指定分区并删除其全部数据" IsChecked="{Binding Plan.ConfirmFormatPartition}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Visibility="{Binding IsFormatDisk,Converter={StaticResource VisibleWhen}}" ToolTip="{Binding DataContext.HelpTips[diskconfirm],RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
            <StackPanel IsEnabled="{Binding IsScriptDisk}" Visibility="{Binding IsScriptDisk,Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="自定义分区脚本（Windows PE / DiskPart）" FontSize="16" Margin="0,12,0,6"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　下方淡色内容是UEFI/GPT 示例，尚未填入，不参与生成。示例会清空磁盘 0，Windows 分区编号为 3；恢复分区 1000 MB，需按实际 WinRE 镜像调整。脚本可操作任意磁盘，上方安装目标不会限制脚本中的 SELECT DISK。" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
              <DockPanel LastChildFill="True" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="复制示例" Command="{x:Static local:ExampleText.CopyCommand}" CommandParameter="{Binding ElementName=DiskPartExampleEditor}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DiskPartExampleEditor,Path=(local:ExampleText.CopyStatus)}" VerticalAlignment="Center" Margin="8,0" MaxWidth="220" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
                <WrapPanel><Button Content="载入示例" Tag="diskpart" Click="DiskScriptExampleClick" HorizontalAlignment="Left" ToolTip="{Binding DataContext.HelpTips[diskscriptexample],RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel>
              </DockPanel>
              <TextBox x:Name="DiskPartExampleEditor" Text="{Binding Plan.DiskPartScript,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExampleEditor}" local:ExampleText.Value="{x:Static core:DiskScriptSettings.Example}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="340" FontFamily="Consolas" FontSize="13" SpellCheck.IsEnabled="False" ToolTip="{Binding DataContext.HelpTips[diskscript],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　仅支持 ASCII 的 DiskPart 命令，每行最多 160 字符、最多 512 行。不支持 CMD / PowerShell、变量、特殊运算符或 noerr。S/W/R 盘符只影响 Windows PE；安装后的系统盘符由 Windows 决定。此项不检测实际磁盘与启动环境。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <CheckBox Content="我已备份并获得操作授权，核对完整脚本及安装目标，确认脚本可能删除任意磁盘的数据" IsChecked="{Binding Plan.ConfirmDiskScript}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" ToolTip="{Binding DataContext.HelpTips[diskconfirm],RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <StackPanel IsEnabled="{Binding IsWipeDisk}" Visibility="{Binding IsWipeDisk,Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="启动与分区类型（须与目标电脑实际启动方式一致）"/>
              <ComboBox x:Name="SettingAnchor066" SelectedValue="{Binding Plan.DiskLayout}" SelectedValuePath="Content" ToolTip="{Binding DataContext.HelpTips[disklayout],RelativeSource={RelativeSource AncestorType=Window}}"><ComboBoxItem Content="UEFI / GPT"/><ComboBoxItem Content="BIOS / MBR"/></ComboBox>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　UEFI/GPT：EFI 300 MB、MSR 16 MB、Windows 剩余空间、恢复分区按下方设置。BIOS/MBR：系统 500 MB、Windows 剩余空间、恢复分区按下方设置；主要适用于 Windows 10 传统 BIOS。实际磁盘容量和恢复镜像大小仍需核对。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
              <TextBlock Text="恢复分区大小（MB，默认 1536；须容纳 WinRE 镜像并预留维护空间）"/><TextBox x:Name="SettingAnchor067" Text="{Binding Plan.RecoverySizeMB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" ToolTip="{Binding DataContext.HelpTips[disklayout],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <CheckBox Content="我已备份并获得操作授权，确认清空指定磁盘的全部分区和数据" IsChecked="{Binding Plan.ConfirmWipeDisk}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" ToolTip="{Binding DataContext.HelpTips[diskconfirm],RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </StackPanel></Border>
          <Border Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" CornerRadius="8" Padding="20" Margin="0,0,0,16" Visibility="{Binding IsDestructiveDisk,Converter={StaticResource VisibleWhen}}"><StackPanel>
            <TextBlock x:Name="SettingAnchor068" Text="危险：安装时可能删除数据" Foreground="{DynamicResource DangerBrush}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding DiskRisk}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource ExplanationText}" Text="　　请先备份并核对目标电脑的磁盘编号。确认不会保存到方案；修改脚本、目标或重新打开方案后需再次勾选。导出时还会再次核对此操作。" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="用户与密码" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
