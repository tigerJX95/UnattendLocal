            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock x:Name="SettingAnchor039" Text="鼠标" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="SettingAnchor040" Content="关闭鼠标“提高指针精确度”" IsChecked="{Binding Plan.DisablePointerPrecision}" ToolTip="{Binding DataContext.HelpTips[pointerprecision],RelativeSource={RelativeSource AncestorType=Window}}"/>
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　减少 Windows 鼠标加速，不调整 DPI、指针速度或游戏内设置。只配置安装后的新建用户；默认遵循 Windows，驱动和应用可能另有独立设置。" Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="版本与密钥" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <Border Style="{StaticResource Card}">
