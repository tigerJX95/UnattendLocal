                          <TextBlock Text="Windows 默认" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                          <TextBlock Text="使用 Windows 默认密码到期策略，通常为 42 天；本工具不额外覆盖系统默认策略。只适用于本地账户。" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </ComboBoxItem.ToolTip>
                  </ComboBoxItem>
                  <ComboBoxItem Content="指定天数">
