            <TextBlock Style="{StaticResource ExplanationText}" Text="{Binding LockScreenSummary,StringFormat='　　{0}'}" Foreground="{DynamicResource SecondaryBrush}"/>
            <StackPanel Visibility="{Binding IsScriptLockScreen,Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource ExplanationText}" Text="　　在安装阶段读取图片，脚本需返回原始字节，不是路径。示例需要安装时可读取的 lockscreen.jpg。" Foreground="{DynamicResource SecondaryBrush}"/>
              <DockPanel LastChildFill="True" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" Content="复制示例" Command="{x:Static local:ExampleText.CopyCommand}" CommandParameter="{Binding ElementName=LockScreenImageEditor}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=LockScreenImageEditor,Path=(local:ExampleText.CopyStatus)}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource SecondaryBrush}"/>
