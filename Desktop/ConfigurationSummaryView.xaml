<UserControl x:Class="UnattendLocal.Desktop.ConfigurationSummaryView" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UnattendLocal.Desktop"
 FontWeight="Normal" Foreground="{DynamicResource ForegroundBrush}" HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource SummaryBasicBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="protection"><Setter Property="Foreground" Value="{DynamicResource SummaryProtectionBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="network"><Setter Property="Foreground" Value="{DynamicResource SummaryNetworkBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="shell"><Setter Property="Foreground" Value="{DynamicResource SummaryShellBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="explorer"><Setter Property="Foreground" Value="{DynamicResource SummaryExplorerBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="appearance"><Setter Property="Foreground" Value="{DynamicResource SummaryAppearanceBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SummaryValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/>
      <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
        <Condition Binding="{Binding SourceLabel}" Value="磁盘分区"/>
        <Condition Binding="{Binding IsDestructiveDisk,RelativeSource={RelativeSource AncestorType=local:ConfigurationSummaryView}}" Value="True"/>
      </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <ItemsControl ItemsSource="{Binding Presentation.Sections,ElementName=Root}" HorizontalContentAlignment="Stretch" Visibility="{Binding ShowDetails,ElementName=Root,Converter={StaticResource VisibleWhen}}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,0,0,16">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,7" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
          </Border>
          <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,16,0">
                <TextBlock.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{Binding SourceLabel}"/></TextBlock.ToolTip>
              </TextBlock>
              <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource SummaryValue}"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Presentation.Reviews.Count,ElementName=Root}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,7" Margin="0,0,0,10">
        <TextBlock Text="导出前检查" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
      </Border>
      <ItemsControl ItemsSource="{Binding Presentation.Reviews,ElementName=Root}"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,16,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{DynamicResource ForegroundBrush}"/>
        </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Presentation.Notices,ElementName=Root}" Visibility="{Binding ShowDetails,ElementName=Root,Converter={StaticResource VisibleWhen}}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource SecondaryBrush}" Margin="0,10,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
</UserControl>
