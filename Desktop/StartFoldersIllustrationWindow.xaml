<Window x:Class="UnattendLocal.Desktop.StartFoldersIllustrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="开始菜单文件夹位置示意" Icon="Assets/App.ico" Width="780" Height="650" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="文件夹入口在哪里？" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Windows 11 开始菜单 · 位置示意（非实机截图）" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,14"/>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="22">
        <StackPanel>
          <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,7"><TextBlock Text="搜索应用、设置和文档" Foreground="{DynamicResource SecondaryBrush}"/></Border>
          <TextBlock Text="已固定" FontWeight="SemiBold" Margin="0,20,0,12"/>
          <UniformGrid Columns="4" Height="95">
            <StackPanel HorizontalAlignment="Center"><Border Width="34" Height="34" Background="#0078D4" CornerRadius="6"/><TextBlock Text="应用" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Center"><Border Width="34" Height="34" Background="#8764B8" CornerRadius="6"/><TextBlock Text="应用" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Center"><Border Width="34" Height="34" Background="#038387" CornerRadius="6"/><TextBlock Text="应用" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Center"><Border Width="34" Height="34" Background="#D83B01" CornerRadius="6"/><TextBlock Text="应用" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
          </UniformGrid>
          <TextBlock Text="推荐" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="最近使用的文件与应用" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,35"/>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="24" Height="24" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,8,0"/><TextBlock Text="用户" VerticalAlignment="Center"/></StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="6" Padding="10,7" Margin="6,0,12,0" Background="{DynamicResource AccentTintBrush}"><StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,14,0"><Path Data="M2,6 V2 H8 L11,5 H22 V19 H2 Z" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.5" Width="22" Height="20" Stretch="Uniform"/><TextBlock Text="文档" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel><Path Data="M12,1 V15 M7,10 L12,15 L17,10 M3,17 V22 H21 V17" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.5" Width="22" Height="20" Stretch="Uniform"/><TextBlock Text="下载" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </StackPanel></Border>
                <StackPanel VerticalAlignment="Center"><Path Data="M12,1 V12 M7,4 A9,9 0 1 0 17,4" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.8" Width="24" Height="24" Stretch="Uniform"/><TextBlock Text="电源" FontSize="12" Margin="0,4,0,0"/></StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock Text="高亮区域：电源按钮左侧的文件夹快捷入口" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,14,0,4"/>
      <TextBlock Text="在“桌面与文件夹”页选择自定义开始菜单文件夹后，可按需显示文档、下载、设置等入口。示意图仅用文档和下载举例，不代表当前已勾选这两项。" Style="{StaticResource ExplanationText}"/>
      <TextBlock Text="这些入口位于开始菜单底部，不是固定应用区，也不是任务栏。取消入口不会删除文件夹或文件；此项仅适用于 Windows 11，实际布局可能随系统版本变化。" Style="{StaticResource ExplanationText}" Foreground="{DynamicResource SecondaryBrush}"/>
    </StackPanel></ScrollViewer>
    <Button Grid.Row="1" Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="关闭位置示意图" TextWrapping="Wrap"/></ToolTip></Button.ToolTip></Button>
  </Grid>
</Window>
