<Window xmlns:loc="clr-namespace:UnattendLocal.Desktop" x:Class="UnattendLocal.Desktop.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{loc:Text text.369b82fa0700}" Icon="Assets/App.ico" Width="600" Height="700" MinWidth="500" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock x:Name="PickerHeading" Text="{loc:Text text.369b82fa0700}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid x:Name="ColorPlane" Height="200" ClipToBounds="True" MouseLeftButtonDown="PlaneDown" MouseMove="PlaneMove" MouseLeftButtonUp="PlaneUp" SizeChanged="PlaneSizeChanged" Focusable="True" KeyDown="PlaneKeyDown" AutomationProperties.Name="{loc:Text text.bf48a311ad97}">
        <Border Background="{Binding HueHex}"/>
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Canvas IsHitTestVisible="False"><Ellipse x:Name="SelectionRing" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent"/><Ellipse x:Name="SelectionOutline" Width="18" Height="18" Stroke="Black" StrokeThickness="1"/></Canvas>
      </Grid>
      <TextBlock Text="{loc:Text text.3ff6d1c07cfc}" Margin="0,12,0,4"/>
      <Grid x:Name="HueStrip" Height="24" Margin="0,0,0,12" Background="Transparent" ClipToBounds="True" Focusable="True" MouseLeftButtonDown="HueDown" MouseMove="HueMove" MouseLeftButtonUp="HueUp" KeyDown="HueKeyDown" SizeChanged="HueSizeChanged" AutomationProperties.Name="{loc:Text text.36913cb06891}">
        <Border CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1666667"/><GradientStop Color="Lime" Offset="0.3333333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6666667"/><GradientStop Color="Magenta" Offset="0.8333333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <Canvas IsHitTestVisible="False"><Border x:Name="HueMarker" Width="6" Height="24" BorderBrush="Black" BorderThickness="1" CornerRadius="2"><Border BorderBrush="White" BorderThickness="1" CornerRadius="1"/></Border></Canvas>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Text text.ac92162ca408}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Red,Mode=TwoWay}" AutomationProperties.Name="{loc:Text text.3a1f029953f0}"/><TextBlock Grid.Column="2" Text="{loc:Display Value={Binding Red}}" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Text="{loc:Text text.a95aec6f60b2}" VerticalAlignment="Center"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Green,Mode=TwoWay}" AutomationProperties.Name="{loc:Text text.c980730070ed}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Display Value={Binding Green}}" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="2" Text="{loc:Text text.3993595cdd07}" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Blue,Mode=TwoWay}" AutomationProperties.Name="{loc:Text text.c5eae8c252b9}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Display Value={Binding Blue}}" HorizontalAlignment="Right"/>
      </Grid>
      <TextBlock Text="HEX（#RRGGBB）" Margin="0,12,0,0"/>
      <DockPanel><Border DockPanel.Dock="Left" Width="54" Height="36" Background="{Binding ColorHex}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4,12,12"/><TextBox Text="{Binding Hex,UpdateSourceTrigger=PropertyChanged}" MaxLength="16" FontFamily="Consolas" FontSize="17" AutomationProperties.Name="{loc:Text text.a1c2723caa06}"/></DockPanel>
      <TextBlock Text="{loc:Display Value={Binding ValidationMessage}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ExplanationText}"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding CanAccept}" Value="False"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{loc:Text text.01777e5f1eb9}" Style="{StaticResource ExplanationText}" Foreground="{DynamicResource SecondaryBrush}"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{loc:Source text.f3393a498bde}" Click="DefaultClick"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Text text.f3393a498bde}"/></Button.ToolTip></Button>
      <Button Content="{loc:Source text.2cd0f3be8738}" IsCancel="True"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Text text.2cd0f3be8738}"/></Button.ToolTip></Button>
      <Button Content="{loc:Source text.fac2a67ad878}" IsDefault="True" IsEnabled="{Binding CanAccept}" Click="AcceptClick"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Text text.fac2a67ad878}"/></Button.ToolTip></Button>
    </WrapPanel>
  </Grid>
</Window>
