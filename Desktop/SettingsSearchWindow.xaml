<Window x:Class="UnattendLocal.Desktop.SettingsSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="搜索设置" Width="740" Height="610" MinWidth="540" MinHeight="410" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="14" PreviewKeyDown="SearchKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="QueryBox" TextChanged="QueryChanged" AutomationProperties.Name="搜索中英文设置名称或关键词" Margin="0,0,0,8"><TextBox.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="支持中文、英文名称、别名及多个关键词，例如 $OEM$、BitLocker、自动登录。Ctrl+L 重新输入。"/></TextBox.ToolTip></TextBox>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Label Content="分类" Target="{Binding ElementName=CategoryPicker}" VerticalAlignment="Center" Padding="0,0,12,0"/>
      <ComboBox Grid.Column="1" x:Name="CategoryPicker" DisplayMemberPath="Label" SelectionChanged="CategoryChanged" AutomationProperties.Name="搜索分类"/>
      <Button Grid.Column="2" Click="ResetClick" ContentTemplate="{x:Null}" AutomationProperties.Name="清空关键词并恢复全部分类"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="清空关键词并恢复全部分类"/></Button.ToolTip><Path Data="M4,4 L16,16 M16,4 L4,16" Width="16" Height="16" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Stretch="Uniform"/></Button>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="CountText" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ListBox Grid.Row="3" x:Name="Results" SelectionChanged="ResultSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="ResultClicked" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="匹配的设置">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Page,StringFormat=所在页面：{0}}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"><TextBlock.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip></TextBlock>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True"/>
      <Button DockPanel.Dock="Right" x:Name="LocateButton" Content="定位所选设置" Click="LocateClick" IsEnabled="False"/>
      <TextBlock Text="点击结果或按 Enter 定位；↑↓ 选择，Esc 关闭。" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
