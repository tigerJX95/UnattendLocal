<Window xmlns:loc="clr-namespace:UnattendLocal.Desktop" x:Class="UnattendLocal.Desktop.SettingsSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{loc:Text text.2874151bd36b}" Width="740" Height="610" MinWidth="540" MinHeight="410" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="14" PreviewKeyDown="SearchKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="QueryBox" TextChanged="QueryChanged" AutomationProperties.Name="{loc:Text text.a6b7799f21f4}" Margin="0,0,0,8"><TextBox.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Source text.654d7d104cfe}"/></TextBox.ToolTip></TextBox>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Label Content="{loc:Source text.515559957fd3}" Target="{Binding ElementName=CategoryPicker}" VerticalAlignment="Center" Padding="0,0,12,0"/>
      <ComboBox Grid.Column="1" x:Name="CategoryPicker"  SelectionChanged="CategoryChanged" AutomationProperties.Name="{loc:Text text.8ea7e2d39807}" loc:LocalizedItems.DisplayPath="Label"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Display Value={Binding Label}}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Button Grid.Column="2" Click="ResetClick" ContentTemplate="{x:Null}" AutomationProperties.Name="{loc:Text text.47a8bdf67931}"><Button.ToolTip><ToolTip ContentTemplate="{x:Null}" Content="{loc:Source text.47a8bdf67931}"/></Button.ToolTip><Path Data="M4,4 L16,16 M16,4 L4,16" Width="16" Height="16" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Stretch="Uniform"/></Button>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="CountText" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ListBox Grid.Row="3" x:Name="Results" SelectionChanged="ResultSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="ResultClicked" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="{loc:Text text.4ec864845901}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7">
        <TextBlock Text="{loc:Display Value={Binding Title}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Display Value={Binding Page}, FormatKey=text.52a4b86f013a}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="{loc:Display Value={Binding Description}}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"><TextBlock.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="{loc:Display Value={Binding TooltipDescription}}" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip></TextBlock>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{loc:Source text.3fd47edce45b}" IsCancel="True"/>
      <Button DockPanel.Dock="Right" x:Name="LocateButton" Content="{loc:Source text.a47cc3117567}" Click="LocateClick" IsEnabled="False"/>
      <TextBlock Text="{loc:Text text.a7b658a1af82}" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
